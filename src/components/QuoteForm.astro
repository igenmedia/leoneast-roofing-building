---
import { company, services } from "../data/company";

interface Props { title?: string; source?: string }
const { title = "Ask us for a price", source = "" } = Astro.props;

// No email address yet, so no Web3Forms key. A form posting without one is
// accepted by the browser and then discarded, which is worse than no form,
// so until the key lands this renders a call panel. Setting `formKey` in
// src/data/company.ts turns the real form back on everywhere.
const live = Boolean(company.formKey);
---

<div class="rounded-lg border border-graphite/15 bg-white p-6 shadow-sm">
  <h2 class="text-xl font-bold text-carbon">{title}</h2>

  {live ? (
    <form action="https://api.web3forms.com/submit" method="POST" class="quote-form mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="access_key" value={company.formKey} />
      <input type="hidden" name="subject" value={`Website enquiry - ${company.name}`} />
      <input type="hidden" name="from_name" value={company.name} />
      <input type="hidden" name="redirect" value={`${company.url}/thank-you`} />
      {source && <input type="hidden" name="page" value={source} />}
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="qf-name" class="block text-sm font-medium text-graphite">Your name</label>
        <input id="qf-name" name="name" type="text" required autocomplete="name"
          class="mt-1 w-full rounded border border-graphite/25 px-3 py-2 text-carbon focus:border-volt focus:ring-volt" />
      </div>
      <div>
        <label for="qf-phone" class="block text-sm font-medium text-graphite">Phone number</label>
        <input id="qf-phone" name="phone" type="tel" required autocomplete="tel"
          class="mt-1 w-full rounded border border-graphite/25 px-3 py-2 text-carbon focus:border-volt focus:ring-volt" />
      </div>
      <div class="sm:col-span-2">
        <label for="qf-job" class="block text-sm font-medium text-graphite">What do you need doing?</label>
        <select id="qf-job" name="job" required
          class="mt-1 w-full rounded border border-graphite/25 px-3 py-2 text-carbon focus:border-volt focus:ring-volt">
          <option value="">Please choose</option>
          {services.map((s) => <option value={s.name}>{s.name}</option>)}
          <option value="Not sure">Not sure - something is wrong up there</option>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label for="qf-detail" class="block text-sm font-medium text-graphite">Anything else worth knowing</label>
        <textarea id="qf-detail" name="detail" rows="3"
          class="mt-1 w-full rounded border border-graphite/25 px-3 py-2 text-carbon focus:border-volt focus:ring-volt"></textarea>
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="w-full sm:w-auto rounded bg-volt px-6 py-3 font-bold text-white hover:bg-volt-deep">
          Send it over
        </button>
      </div>
    </form>
  ) : (
    <div class="mt-3">
      <p class="text-sm text-graphite/70">
        The quickest way to get a price is to ring. Tell us the road and what you have noticed
        and we will arrange a time to come and look.
      </p>
      <a href={company.phoneLink}
        class="mt-4 inline-flex w-full items-center justify-center rounded bg-volt px-6 py-3 text-lg font-bold text-white hover:bg-volt-deep sm:w-auto">
        {company.phone}
      </a>
      <p class="mt-3 text-xs text-graphite/60">{company.hours}. Emergencies answered outside those hours.</p>
    </div>
  )}
</div>

