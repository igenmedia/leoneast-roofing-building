---
import { company } from "../data/company";

interface Props { heading?: string }
const { heading = "Our patch on Google Maps" } = Astro.props;
---

<section class="bg-white border-y border-graphite/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
    <h2 class="text-2xl sm:text-3xl font-bold text-carbon">{heading}</h2>
    <p class="mt-3 max-w-3xl text-graphite/80">
      We are listed on Google as a service-area business, so the map shades the ground we cover
      around Bromley instead of putting a pin on a door. That is how we work anyway: nobody
      comes to us, we come out to the roof.
    </p>
    <div class="mt-6 overflow-hidden rounded-lg border border-graphite/15">
      <iframe
        src={company.gbpEmbed}
        title={`${company.short} Roofing & Building on Google Maps`}
        width="600"
        height="450"
        class="block w-full h-80 sm:h-[450px]"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <a href={company.googleBusinessProfile} target="_blank" rel="noopener noreferrer"
      class="mt-5 inline-flex items-center gap-1 font-semibold text-volt-deep hover:underline">
      Look up LeonEast on Google<span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>
