---
import { business } from "../data/business";

interface Props {
  title?: string;
  compact?: boolean;
  /** Which page the enquiry came from, for lead tracking. */
  page?: string;
}

const { title = "Get A Free Quote", compact = false, page = "" } = Astro.props;

// The client has not supplied an email address yet, so there is no Web3Forms
// access key. A form posting to Web3Forms without one accepts the submission
// in the browser and then throws it away, which is worse than no form at all -
// so until the key lands we render a call panel instead. Setting
// `web3formsAccessKey` in src/data/business.ts switches the real form back on
// everywhere at once, with no other change needed.
const formLive = Boolean(business.web3formsAccessKey);
---

<div class:list={["rounded-xl border border-slate/10 bg-white shadow-lg", compact ? "p-6" : "p-6 sm:p-8"]}>
  <h2 class="text-2xl font-bold text-ink">{title}</h2>

  {formLive ? (
    <>
      <p class="mt-1 text-sm text-slate/70">
        Leave your details and we will ring you back to arrange the survey. There is no charge
        for it and nothing to sign afterwards. If the honest finding is that your roof needs
        no work this year, that is the finding you will get, in writing.
      </p>
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form mt-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-4"
      >
        <input type="hidden" name="access_key" value={business.web3formsAccessKey} />
        <input type="hidden" name="subject" value={`New quote request - ${business.name}`} />
        <input type="hidden" name="from_name" value={business.name} />
        <input type="hidden" name="redirect" value={`${business.url}/thank-you`} />
        {page && <input type="hidden" name="page" value={page} />}
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

        <div>
          <label for="cf-name" class="block text-sm font-medium text-slate">Name</label>
          <input type="text" name="name" id="cf-name" required autocomplete="name"
            class="mt-1 block w-full rounded-md border border-slate/25 px-3 py-2 text-ink shadow-sm focus:border-brand focus:ring-brand sm:text-sm" />
        </div>
        <div>
          <label for="cf-email" class="block text-sm font-medium text-slate">Email</label>
          <input type="email" name="email" id="cf-email" required autocomplete="email"
            class="mt-1 block w-full rounded-md border border-slate/25 px-3 py-2 text-ink shadow-sm focus:border-brand focus:ring-brand sm:text-sm" />
        </div>
        <div>
          <label for="cf-phone" class="block text-sm font-medium text-slate">Phone Number</label>
          <input type="tel" name="phone" id="cf-phone" required autocomplete="tel"
            class="mt-1 block w-full rounded-md border border-slate/25 px-3 py-2 text-ink shadow-sm focus:border-brand focus:ring-brand sm:text-sm" />
        </div>
        <div>
          <label for="cf-service" class="block text-sm font-medium text-slate">What Do You Need?</label>
          <select name="service" id="cf-service" required
            class="mt-1 block w-full rounded-md border border-slate/25 px-3 py-2 text-ink shadow-sm focus:border-brand focus:ring-brand sm:text-sm">
            <option value="">Please select...</option>
            {business.services.map((service) => (
              <option value={service}>{service}</option>
            ))}
            <option value="Not sure yet">Not sure - something is wrong up there</option>
            <option value="Other">Other (please specify)</option>
          </select>
        </div>
        <div class="other-detail sm:col-span-2 lg:col-span-4 hidden">
          <label for="cf-other" class="block text-sm font-medium text-slate">Please Specify</label>
          <input type="text" name="other_detail" id="cf-other"
            class="mt-1 block w-full rounded-md border border-slate/25 px-3 py-2 text-ink shadow-sm focus:border-brand focus:ring-brand sm:text-sm" />
        </div>

        <div class="sm:col-span-2 lg:col-span-4">
          <button type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
            Book My Free Survey
          </button>
        </div>
      </form>
    </>
  ) : (
    <div class="mt-2 grid gap-6 sm:grid-cols-2 sm:items-center">
      <div>
        <p class="text-sm text-slate/70">
          The quickest way to book a free survey is to ring us. Tell us the street and what you
          have spotted - a mark on a ceiling, a tile in the garden, a gutter that waterfalls at
          one corner - and we will arrange a time to come and look. No charge for the visit and
          nothing to sign afterwards.
        </p>
        <p class="mt-3 text-sm text-slate/70">
          If the honest verdict is that your roof needs nothing doing this year, that is the
          verdict you will get.
        </p>
      </div>
      <div class="rounded-lg border border-brand/30 bg-brand/5 p-5 text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark">Call {business.shortName}</p>
        <a href={business.phoneHref} class="mt-2 block text-2xl sm:text-3xl font-bold text-ink hover:text-brand-dark">
          {business.phone}
        </a>
        <p class="mt-2 text-xs text-slate/60">
          {business.openingHours.opens} to {business.openingHours.closes}, Monday to Saturday.
          Emergencies answered outside those hours.
        </p>
        <a href={business.phoneHref}
          class="mt-4 inline-flex w-full items-center justify-center rounded-md bg-brand px-5 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
          Call now
        </a>
      </div>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLFormElement>(".contact-form").forEach((form) => {
    const serviceSelect = form.querySelector<HTMLSelectElement>('select[name="service"]');
    const otherWrap = form.querySelector<HTMLElement>(".other-detail");
    const otherInput = otherWrap?.querySelector<HTMLInputElement>("input");

    serviceSelect?.addEventListener("change", () => {
      const isOther = serviceSelect.value === "Other";
      otherWrap?.classList.toggle("hidden", !isOther);
      if (otherInput) otherInput.required = isOther;
    });
  });
</script>
