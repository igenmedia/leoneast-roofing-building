---
import { company } from "../data/company";

interface Props { heading?: string; text?: string }
const {
  heading = "Want someone to come and look at it?",
  text = "Ring us and tell us what you have spotted. We will come out, have a proper look and tell you what it needs - there is no charge for that and nothing to sign afterwards.",
} = Astro.props;
---

<section class="bg-carbon text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:flex sm:items-center sm:justify-between sm:gap-8">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold">{heading}</h2>
      <p class="mt-3 max-w-2xl text-mist/80">{text}</p>
    </div>
    <div class="mt-6 sm:mt-0 flex-none">
      <a href={company.phoneLink}
        class="inline-flex items-center rounded bg-volt px-6 py-3 text-lg font-bold text-white hover:bg-volt-deep">
        {company.phone}
      </a>
    </div>
  </div>
</section>
