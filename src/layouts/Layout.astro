---
import "../styles/global.css";
import { business, img } from "../data/business";
import { locations } from "../data/locations";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** URL of the page's LCP image, so it can be preloaded in <head>. */
  heroImage?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = img("orpington-rooftops-suburban-skyline"),
  heroImage,
  schema = [],
  noindex = false,
} = Astro.props;

const cleanPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
const canonicalURL = new URL(cleanPath || "/", business.url).toString();
const ogImageURL = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, business.url).toString();

export const serviceLinks = [
  { name: "Roof Repairs", slug: "/roof-repairs" },
  { name: "Emergency Roof Repairs", slug: "/emergency-roof-repairs" },
  { name: "Storm Damage Repairs", slug: "/storm-damage-repairs" },
  { name: "Roof Leak Repairs", slug: "/roof-leak-repairs" },
  { name: "New Roofs & Re-Roofing", slug: "/new-roofs" },
  { name: "Flat Roofing", slug: "/flat-roofing" },
  { name: "Tiling & Slating", slug: "/tiling-and-slating" },
  { name: "Chimney Repairs", slug: "/chimney-repairs" },
  { name: "Guttering, Fascias & Soffits", slug: "/guttering-fascias-and-soffits" },
];

const LOGO = "/images/leoneast-roofing-logo.svg";

// Everything the client has not supplied yet is behind a flag, so the site
// renders correctly and honestly today and improves the moment the details
// land in src/data/business.ts. Nothing here invents a value.
const hasAddress = Boolean(business.address.street && business.address.postcode);
const hasEmail = Boolean(business.email);
const hasCompanyDetails = Boolean(business.companyNumber);

// Single-path brand marks so the footer icons inherit currentColor and cost
// nothing - no icon library, no external CSS request.
const socialIcons: Record<string, string> = {
  Facebook:
    "M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z",
  Instagram:
    "M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.89 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 2.7.27.28 2.69.08 7.05.02 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.97-6.98.06-1.28.08-1.69.08-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z",
  YouTube:
    "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z",
  LinkedIn:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z",
  TikTok:
    "M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .77-5.06V9.69a5.67 5.67 0 0 0-.77-.05A5.68 5.68 0 1 0 15.54 15.3V8.9a7.35 7.35 0 0 0 4.3 1.38V7.19a4.3 4.3 0 0 1-3.24-1.37Z",
  X: "M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.96 6.82H1.67l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z",
  Fallback:
    "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2c1.2 0 2.9 2.4 3.2 6H8.8C9.1 6.4 10.8 4 12 4Zm-5.7 2.6A13 13 0 0 0 6.8 10H4.3a8 8 0 0 1 2-3.4ZM4.3 14h2.5c.1 1.2.3 2.3.6 3.4a8 8 0 0 1-3.1-3.4Zm4.5-2h6.4c-.3 3.6-2 6-3.2 6s-2.9-2.4-3.2-6Zm8.4 0h2.5a8 8 0 0 1-2 3.4c.3-1.1.5-2.2.5-3.4Z",
};

// No `address` block is emitted while the client has no published trading
// address, and no AggregateRating is emitted at all - there are no genuine
// reviews to base one on. An incomplete but truthful LocalBusiness record is
// worth considerably more than a padded one.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: business.name,
  url: business.url,
  description:
    "LeonEast Roofing & Building Limited carries out roof repairs, re-roofing, flat roofing, tiling and slating, chimney work and guttering across Orpington, Bromley and the surrounding BR postcodes.",
  telephone: business.phone,
  ...(hasEmail ? { email: business.email } : {}),
  image: ogImageURL,
  logo: `${business.url}${LOGO}`,
  address: {
    "@type": "PostalAddress",
    ...(hasAddress ? { streetAddress: business.address.street } : {}),
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    ...(hasAddress ? { postalCode: business.address.postcode } : {}),
    addressCountry: business.country,
  },
  areaServed: [
    { "@type": "City", name: business.location },
    ...locations.map((l) => ({ "@type": "City", name: l.name })),
  ],
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: business.openingHours.days,
    opens: business.openingHours.opens,
    closes: business.openingHours.closes,
  },
  ...(business.sameAs.length ? { sameAs: business.sameAs } : {}),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: business.name,
  url: business.url,
};

const allSchema = [websiteSchema, localBusinessSchema, ...schema];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" as="font" type="font/woff2" href="/fonts/sora-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-var.woff2" crossorigin />
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {allSchema.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="bg-paper text-slate antialiased">
    <!-- Strip above the header -->
    <div class="bg-slate text-steel-light text-xs sm:text-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-1 py-2 text-center">
        <span class="font-semibold text-brand-light">Orpington based, covering the BR postcodes</span>
        <span class="hidden sm:inline text-steel">|</span>
        <span>Free roof surveys</span>
        <span class="hidden sm:inline text-steel">|</span>
        <span class="hidden sm:inline">Fixed written prices</span>
        <span class="hidden sm:inline text-steel">|</span>
        <span>{business.workmanshipGuaranteeYears} year written guarantee</span>
      </div>
    </div>

    <header class="sticky top-0 z-50 bg-ink border-b border-steel">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between py-2">
          <a href="/" class="flex items-center" aria-label={`${business.name} home`}>
            <img
              src={LOGO}
              alt={`${business.name} logo`}
              class="h-12 sm:h-14 w-auto"
              width="560"
              height="150"
            />
          </a>
          <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-steel-light" aria-label="Main">
            <a href="/" class="hover:text-brand-light">Home</a>
            <div class="relative" id="services-menu">
              <button
                id="services-btn"
                type="button"
                class="flex items-center gap-1 hover:text-brand-light"
                aria-haspopup="true"
                aria-expanded="false"
              >
                Services
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform" id="services-chevron" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div
                id="services-dropdown"
                class="absolute left-0 top-full mt-2 hidden w-72 rounded-lg border border-steel bg-slate py-1 shadow-xl z-50"
              >
                {serviceLinks.map((s) => (
                  <a href={s.slug} class="block px-4 py-2 text-steel-light hover:bg-steel hover:text-brand-light">{s.name}</a>
                ))}
              </div>
            </div>
            <div class="relative" id="areas-menu">
              <button
                id="areas-btn"
                type="button"
                class="flex items-center gap-1 hover:text-brand-light"
                aria-haspopup="true"
                aria-expanded="false"
              >
                Areas
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition-transform" id="areas-chevron" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                </svg>
              </button>
              <div
                id="areas-dropdown"
                class="absolute left-0 top-full mt-2 hidden w-60 rounded-lg border border-steel bg-slate py-1 shadow-xl z-50 max-h-96 overflow-y-auto"
              >
                {locations.map((l) => (
                  <a href={`/${l.slug}`} class="block px-4 py-2 text-steel-light hover:bg-steel hover:text-brand-light">{l.name}</a>
                ))}
              </div>
            </div>
            <a href="/common-roof-problems" class="hover:text-brand-light">Roof Problems</a>
            <a href="/roof-repair-cost" class="hover:text-brand-light">Cost</a>
            <a href="/blog" class="hover:text-brand-light">Blog</a>
            <a href="/contact" class="hover:text-brand-light">Contact</a>
          </nav>
          <div class="flex items-center gap-2">
            <a
              href={business.phoneHref}
              class="hidden sm:inline-flex items-center rounded-md bg-brand px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink"
            >
              Call {business.phone}
            </a>
            <a
              href={business.phoneHref}
              aria-label={`Call ${business.phone}`}
              class="sm:hidden inline-flex items-center justify-center rounded-md bg-brand p-2 text-white shadow-sm hover:bg-brand-light"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                <path d="M2.25 6.75c0-1.012.674-1.9 1.652-2.18l3.46-.987a1.875 1.875 0 0 1 2.218 1.073l1.385 3.115a1.875 1.875 0 0 1-.46 2.156l-1.4 1.234c-.184.16-.245.42-.13.642a11.485 11.485 0 0 0 5.16 5.16c.223.115.483.054.642-.13l1.234-1.4a1.875 1.875 0 0 1 2.156-.46l3.115 1.385a1.875 1.875 0 0 1 1.073 2.218l-.987 3.46A2.25 2.25 0 0 1 17.25 21.75H16.5C8.835 21.75 2.25 15.165 2.25 7.5v-.75Z" />
              </svg>
            </a>
            <button
              id="mobile-menu-button"
              type="button"
              class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-steel-light hover:bg-steel"
              aria-label="Toggle navigation"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg id="mobile-menu-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
              </svg>
              <svg id="mobile-menu-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-6 w-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <nav id="mobile-menu" class="hidden lg:hidden flex-col gap-1 pb-4 text-sm font-semibold text-steel-light" aria-label="Mobile">
          <a href="/" class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">Home</a>
          {serviceLinks.map((s) => (
            <a href={s.slug} class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">{s.name}</a>
          ))}
          <p class="px-3 pt-2 text-xs uppercase tracking-wide text-steel-light/50">Areas</p>
          {locations.map((l) => (
            <a href={`/${l.slug}`} class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">{l.name}</a>
          ))}
          <a href="/common-roof-problems" class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">Common Roof Problems</a>
          <a href="/roof-repair-cost" class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">Roof Repair Cost</a>
          <a href="/blog" class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">Blog</a>
          <a href="/contact" class="rounded-md px-3 py-2 hover:bg-steel hover:text-brand-light">Contact</a>
        </nav>
      </div>
    </header>

    <script>
      const menuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("mobile-menu-icon-open");
      const iconClose = document.getElementById("mobile-menu-icon-close");

      menuButton?.addEventListener("click", () => {
        const isHidden = mobileMenu?.classList.toggle("hidden");
        mobileMenu?.classList.toggle("flex", !isHidden);
        iconOpen?.classList.toggle("hidden");
        iconClose?.classList.toggle("hidden");
        menuButton.setAttribute("aria-expanded", isHidden ? "false" : "true");
      });

      function wireDropdown(btnId: string, ddId: string, chevId: string) {
        const btn = document.getElementById(btnId);
        const dd = document.getElementById(ddId);
        const chev = document.getElementById(chevId);
        btn?.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll(".nav-dd").forEach((el) => {
            if (el !== dd) el.classList.add("hidden");
          });
          const isHidden = dd?.classList.toggle("hidden");
          chev?.classList.toggle("rotate-180");
          btn.setAttribute("aria-expanded", isHidden ? "false" : "true");
        });
        dd?.classList.add("nav-dd");
        document.addEventListener("click", () => {
          dd?.classList.add("hidden");
          chev?.classList.remove("rotate-180");
          btn?.setAttribute("aria-expanded", "false");
        });
      }
      wireDropdown("services-btn", "services-dropdown", "services-chevron");
      wireDropdown("areas-btn", "areas-dropdown", "areas-chevron");
    </script>

    <main>
      <slot />
    </main>

    <footer class="bg-ink border-t border-steel text-steel-light">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid gap-10 md:grid-cols-3">
        <div>
          <img
            src={LOGO}
            alt={`${business.name} logo`}
            class="h-14 w-auto mb-4"
            width="560"
            height="150"
          />
          <p class="text-sm text-steel-light/70">
            Roofing for Orpington and the BR postcodes around it. Leaks traced to where the
            water actually gets in, storm damage documented for your insurer, hips and ridges
            rebedded, chimneys releaded, flat roofs re-covered and full roofs replaced - every
            job surveyed free, priced in writing and backed by a
            {" "}{business.workmanshipGuaranteeYears} year workmanship guarantee.
          </p>
          {business.socials.length > 0 && (
            <ul class="mt-5 flex items-center gap-3">
              {business.socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer me"
                    aria-label={`${business.name} on ${s.name}`}
                    title={s.name}
                    class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-steel text-steel-light/70 transition hover:border-brand hover:text-brand-light"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                      <path d={socialIcons[s.name] ?? socialIcons.Fallback} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-3">Contact</h3>
          <ul class="space-y-2 text-sm text-steel-light/70">
            <li><a href={business.phoneHref} class="hover:text-brand-light">{business.phone}</a></li>
            {hasEmail && (
              <li><a href={`mailto:${business.email}`} class="hover:text-brand-light break-all">{business.email}</a></li>
            )}
            {hasAddress && (
              <li>{business.address.street}, {business.address.locality}, {business.address.postcode}</li>
            )}
            <li>{business.serviceAreaLabel}</li>
          </ul>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wide mt-6 mb-3">Areas We Cover</h3>
          <ul class="space-y-2 text-sm text-steel-light/70">
            {locations.map((l) => (
              <li><a href={`/${l.slug}`} class="hover:text-brand-light">Roofers in {l.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wide mb-3">Services</h3>
          <ul class="space-y-2 text-sm text-steel-light/70">
            {serviceLinks.map((s) => (
              <li><a href={s.slug} class="hover:text-brand-light">{s.name}</a></li>
            ))}
            <li><a href="/common-roof-problems" class="hover:text-brand-light">Common Roof Problems</a></li>
            <li><a href="/roof-repair-cost" class="hover:text-brand-light">Roof Repair Cost</a></li>
            <li><a href="/blog" class="hover:text-brand-light">Blog</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-steel py-6 text-center text-xs text-steel-light/60 px-4 space-y-2 max-w-4xl mx-auto">
        <p>
          {hasCompanyDetails ? (
            <>
              {business.name} is registered in England and Wales, company number
              {" "}{business.companyNumber}
              {business.registeredOffice ? `, registered office ${business.registeredOffice}` : ""}.
            </>
          ) : (
            <>{business.name} is a limited company registered in England and Wales.</>
          )}
        </p>
        <p class="pt-2 text-steel-light/50">
          &copy; {year} {business.name}. All rights reserved.
          <span class="mx-2">·</span>
          <a href="/privacy-policy" class="hover:text-steel-light hover:underline">Privacy Policy</a>
          <span class="mx-2">·</span>
          <a href="/terms-and-conditions" class="hover:text-steel-light hover:underline">Terms &amp; Conditions</a>
        </p>
      </div>
    </footer>
  </body>
</html>
