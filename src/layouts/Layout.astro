---
import "../styles/global.css";
import { company, photo } from "../data/company";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Set on the two pages that carry a LocalBusiness listing. */
  listing?: boolean;
  lead?: string;
  noindex?: boolean;
}

const { title, description, listing = false, lead, noindex = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "");
const canonical = new URL(path || "/", company.url).toString();
const share = new URL(photo("bromley-terraced-rooftops-chimneys-hero"), company.url).toString();

// One listing block, on the homepage and the contact page only. No FAQ,
// Service or Breadcrumb markup - this is a small firm's website, not a
// content operation, and the markup should say the same thing.
const hasEmail = Boolean(company.email);
const listingSchema = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: company.name,
  url: company.url,
  telephone: company.phone,
  ...(hasEmail ? { email: company.email } : {}),
  image: share,
  logo: `${company.url}/images/leoneast-roofing-logo.svg`,
  address: {
    "@type": "PostalAddress",
    streetAddress: `${company.office.line1}, ${company.office.line2}`,
    addressLocality: company.office.town,
    addressRegion: company.county,
    postalCode: company.office.postcode,
    addressCountry: "GB",
  },
  geo: { "@type": "GeoCoordinates", latitude: company.latitude, longitude: company.longitude },
  ...(company.social.length ? { sameAs: company.social.map((s) => s.url) } : {}),
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" as="font" type="font/woff2" href="/fonts/sora-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope-var.woff2" crossorigin />
    {lead && <link rel="preload" as="image" href={lead} fetchpriority="high" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={share} />
    <meta name="twitter:card" content="summary_large_image" />

    {listing && <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} />}
  </head>
  <body class="bg-bone text-graphite antialiased">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
