---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business";
import NextPage from "../components/NextPage.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${business.url}/blog` },
  ],
};
---

<Layout
  title="Roofing Advice For Bromley Homes | LeonEast Roofing"
  description="Roofing guides written for houses around Bromley - what work costs, which faults matter, and how to tell a good quote from an optimistic one."
  schema={[breadcrumbSchema]}
>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16 text-center">
      <nav aria-label="Breadcrumb" class="text-xs text-steel-light/60">
        <a href="/" class="hover:text-brand-light">Home</a>
        <span class="mx-2 text-steel">/</span>
        <span class="text-steel-light">Blog</span>
      </nav>
      <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight leading-tight">
        <a href="/" class="text-white hover:text-brand-light transition-colors">Roofing Advice For Bromley Homes</a>
      </h1>
      <h2 class="mt-4 text-xl font-semibold text-brand-light">Worth reading before you ring anybody</h2>
      <h3 class="mt-3 text-lg font-semibold text-steel-light">
        Guides built around the housing, weather and planning rules of this particular corner
        of south east London and west Kent
      </h3>
      <p class="mt-6 text-steel-light">
        There is a great deal of roofing advice on the internet and most of it is written for
        nowhere in particular. These are written for the interwar semis at Crofton, the garden
        suburb at Petts Wood, the postwar estates through the Crays and the chalk villages up
        towards the Downs - because what fails, and when, genuinely depends on which of those
        you live in.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    {posts.length === 0 ? (
      <p class="text-center text-slate/70">The first guides are being written now. Check back shortly.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class="group rounded-xl border border-slate/15 bg-white overflow-hidden shadow-sm hover:border-brand transition-colors flex flex-col">
            <img
              src={post.data.heroImage}
              alt={post.data.heroImageAlt}
              class="w-full object-cover aspect-[3/2]"
              width="600" height="400"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
            />
            <div class="p-6 flex flex-col flex-1">
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-dark">
                {post.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
              </p>
              <h2 class="mt-2 text-lg font-bold text-ink group-hover:text-brand-dark">{post.data.title}</h2>
              <p class="mt-2 text-sm text-slate/80 flex-1">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-dark">
                Read the guide<span aria-hidden="true">&rarr;</span>
                <span class="sr-only">: {post.data.title}</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="bg-ink text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">Rather just have someone look at it?</h2>
      <p class="mt-6 text-steel-light max-w-2xl mx-auto">
        The survey is free and it takes about half an hour. You will get photographs of
        anything worth seeing and a written verdict on how urgent it really is.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={business.phoneHref} class="inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
          Call {business.phone}
        </a>
        <a href="/contact" class="inline-flex items-center rounded-md border border-steel-light/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10">
          Book A Free Survey
        </a>
      </div>
    </div>
  </section>

  <NextPage current="/blog" />
</Layout>
