---
import Layout from "../layouts/Layout.astro";
import { company, photo } from "../data/company";
import QuoteForm from "../components/QuoteForm.astro";
import GbpMap from "../components/GbpMap.astro";
const lead = photo("contact-leoneast-roofing-bromley");
const hasEmail = Boolean(company.email);
---

<Layout
  title="Contact | LeonEast Roofing & Building, Bromley"
  description="Get in touch with LeonEast Roofing & Building in Bromley. Call 07746 517099. Free look at the job, fixed written prices, 10 year workmanship guarantee."
  listing={true}
  lead={lead}
>
  <section class="bg-carbon text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight">Get in touch</h1>
      <p class="mt-5 max-w-3xl text-lg text-mist">
        The quickest way to reach us is the phone. Tell us the road and what you have
        spotted - a tile in the border, a mark on a ceiling, a gutter that pours over every
        time it rains - and we will arrange a time to come and look.
      </p>
      <a href={company.phoneLink} class="mt-7 inline-flex rounded bg-volt px-7 py-4 text-xl font-bold text-white hover:bg-volt-deep">
        {company.phone}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 grid lg:grid-cols-2 gap-10 items-start">
    <div>
      <QuoteForm title="Or send us the details" source="Contact page" />

      <div class="mt-8 rounded-lg border border-volt/30 bg-volt/5 p-6">
        <h2 class="text-lg font-bold text-carbon">If water is coming in right now</h2>
        <p class="mt-3 text-sm text-graphite/80">
          Ring rather than filling anything in. Turn the electricity off to any circuit near
          the water, move what you can and get buckets down. If a ceiling is sagging and
          holding water, piercing it deliberately at the lowest point will let it drain in
          one place instead of bringing the whole board down.
        </p>
        <p class="mt-3 text-sm text-graphite/80">
          Then photograph everything before anyone touches it. If it turns into an insurance
          claim, those photographs are what decide it.
        </p>
      </div>
    </div>

    <div>
      <dl class="space-y-6">
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-graphite/60">Phone</dt>
          <dd class="mt-1"><a href={company.phoneLink} class="text-2xl font-bold text-carbon hover:text-volt-deep">{company.phone}</a></dd>
        </div>
        {hasEmail && (
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wide text-graphite/60">Email</dt>
            <dd class="mt-1"><a href={`mailto:${company.email}`} class="font-semibold text-carbon hover:text-volt-deep break-all">{company.email}</a></dd>
          </div>
        )}
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-graphite/60">Hours</dt>
          <dd class="mt-1 text-graphite/80">{company.hours}. Emergencies answered outside those hours, though whether we can safely get on a roof depends on the weather and we will be straight with you about that.</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-graphite/60">Office</dt>
          <dd class="mt-1">
            <address class="not-italic text-graphite/80">
              {company.office.line1}<br />{company.office.line2}<br />
              {company.office.town}<br />{company.office.postcode}
            </address>
            <p class="mt-2 text-sm text-graphite/60">Post and paperwork only - we come to you.</p>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold uppercase tracking-wide text-graphite/60">Trading address</dt>
          <dd class="mt-1">
            <address class="not-italic text-graphite/80">
              {company.tradingAddress.line1}<br />{company.tradingAddress.line2}<br />
              {company.tradingAddress.town}<br />{company.tradingAddress.postcode}
            </address>
          </dd>
        </div>
      </dl>

      <img src={lead} alt="A brick terrace with bay windows on a south London residential street"
        class="mt-8 w-full rounded-lg object-cover aspect-[3/2]" width="800" height="533" loading="lazy" />
    </div>
  </section>

  <GbpMap heading="The area we cover, on Google" />
</Layout>
