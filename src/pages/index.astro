---
import Layout from "../layouts/Layout.astro";
import { company, photo, services } from "../data/company";
import { areas } from "../data/areas";
import QuoteForm from "../components/QuoteForm.astro";
import Testimonials from "../components/Testimonials.astro";
import CallStrip from "../components/CallStrip.astro";
import GbpMap from "../components/GbpMap.astro";

const lead = photo("roof-retiling-scaffold-brick-semi-leoneast");

const recent = [
  { img: "roof-stripped-new-battens-membrane-leoneast",
    alt: "A re-roof part way through, old tiles stripped and new yellow battens fixed over fresh breathable membrane",
    caption: "Re-roof, stripped back to new battens and membrane" },
  { img: "felt-flat-roof-terrace-extension-leoneast",
    alt: "A newly finished mineral felt flat roof on the back extension of a London stock brick terrace",
    caption: "New felt flat roof over a back extension" },
  { img: "scaffold-fascia-work-townhouses-leoneast",
    alt: "Two of the LeonEast team putting up scaffolding across the front of three storey tile-hung townhouses",
    caption: "Scaffold going up for roofline work on townhouses" },
];

const cards = [
  { ...services[0], img: "roof-repairs-bromley-card", alt: "Moss and lichen spreading across the tiles and ridge of an older roof",
    text: "Slipped and broken tiles, cracked hip and ridge mortar, tired flashings, leaks traced back to where the water actually gets in." },
  { ...services[1], img: "new-roof-reroofing-bromley-card", alt: "Newly tiled pitched roofs across an English housing estate",
    text: "Stripped back to the rafters, new treated battens and membrane, then re-covered in tiles or slate matched to the house." },
  { ...services[2], img: "flat-roofing-bromley-card", alt: "Flat roofs over the rear extensions of a row of English terraced houses",
    text: "EPDM rubber, fibreglass and felt on extensions, dormers and garages, with the fall corrected rather than covered over." },
  { ...services[3], img: "chimney-stacks-clay-pots-bromley-card", alt: "Brick chimney stacks with clay pots above a slate roof on an English house",
    text: "Lead flashings, repointing, flaunching and pots, plus guttering, fascias and soffits cleared or replaced." },
];
---

<Layout
  title="LeonEast Roofing & Building | Roofers in Bromley"
  description="Roofing and building work across Bromley and south east London. Repairs, new roofs, flat roofing, chimneys and guttering. Free look, fixed price, 10 year guarantee."
  listing={true}
  lead={lead}
>
  <!-- Hero -->
  <section class="bg-carbon text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 lg:py-16 grid lg:grid-cols-5 gap-10 items-center">
      <div class="lg:col-span-3">
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight">
          <span class="brushed">Roofing and building</span><br />
          <span class="text-volt-bright">in Bromley</span>
        </h1>
        <p class="mt-6 text-lg text-mist">
          {company.name} covers roofs across Bromley and the towns around it - repairs and
          leaks, full re-roofs, flat roofing, chimneys and guttering. We come and look at the
          job before we price it, we tell you what it actually needs rather than what we would
          rather sell you, and the figure we quote is the figure you pay.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={company.phoneLink} class="rounded bg-volt px-6 py-3 text-lg font-bold text-white hover:bg-volt-deep">
            {company.phone}
          </a>
          <a href="/contact" class="rounded border border-mist/40 px-6 py-3 text-lg font-semibold text-white hover:bg-white/10">
            Get in touch
          </a>
        </div>
        <p class="mt-5 text-sm text-mist/60">
          {company.guaranteeYears} year guarantee on our workmanship · Public liability insured · {company.hours}
        </p>
      </div>
      <div class="lg:col-span-2">
        <img src={lead} alt="The LeonEast team re-tiling the roof of a red brick semi from a full scaffold"
          class="w-full rounded-lg object-cover aspect-[4/3]" width="845" height="634"
          fetchpriority="high" loading="eager" />
      </div>
    </div>
  </section>

  <!-- Our own jobs -->
  <section class="bg-carbon text-white border-t border-white/10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pb-12 lg:pb-16 pt-2">
      <h2 class="text-xl sm:text-2xl font-bold">Recent jobs - our own photos</h2>
      <p class="mt-2 text-sm text-mist/80">
        Taken on site by us, not pulled from a picture library. This is what the work looks like halfway through.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {recent.map((r) => (
          <figure>
            <img src={photo(r.img)} alt={r.alt} class="w-full rounded-lg object-cover aspect-[4/3]"
              width="800" height="600" loading="lazy" />
            <figcaption class="mt-2 text-sm text-mist">{r.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
    <h2 class="text-2xl sm:text-3xl font-bold text-carbon">What we do</h2>
    <p class="mt-3 max-w-3xl text-graphite/80">
      Four things, done properly, rather than a list of twenty. If your job is not on here it
      is still worth ringing - most roofing work overlaps and we would rather tell you on the
      phone than have you guess.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {cards.map((c) => (
        <a href={c.href} class="group rounded-lg border border-graphite/15 bg-white overflow-hidden hover:border-volt">
          <img src={photo(c.img)} alt={c.alt} class="w-full object-cover aspect-[3/2]"
            width="600" height="400" loading="lazy" />
          <div class="p-5">
            <h3 class="text-lg font-bold text-carbon group-hover:text-volt-deep">{c.name}</h3>
            <p class="mt-2 text-sm text-graphite/80">{c.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Why us + form -->
  <section class="bg-white border-y border-graphite/10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-carbon">How we work</h2>
        <ul class="mt-6 space-y-5">
          <li>
            <h3 class="font-bold text-carbon">We look before we price</h3>
            <p class="mt-1 text-sm text-graphite/80">
              Nobody can tell what a roof needs from the pavement. We get up there, and into
              the loft too where there is a leak involved, because that is where the evidence
              of where water has been running actually is.
            </p>
          </li>
          <li>
            <h3 class="font-bold text-carbon">You see the problem before you hear a price</h3>
            <p class="mt-1 text-sm text-graphite/80">
              Photographs first, figure second. If you want to compare us against someone
              else, those photographs will tell you whether you are both talking about the
              same job.
            </p>
          </li>
          <li>
            <h3 class="font-bold text-carbon">Scaffolding is on the quote, not added later</h3>
            <p class="mt-1 text-sm text-graphite/80">
              Access is often the biggest single cost on a roofing job and the one people are
              least ready for. It goes on its own line, with how long it stays up.
            </p>
          </li>
          <li>
            <h3 class="font-bold text-carbon">We will tell you if it does not need doing</h3>
            <p class="mt-1 text-sm text-graphite/80">
              Plenty of the calls we take turn out to be condensation rather than a leak, or a
              roof with years left in it. You will get told that, and it costs you nothing.
            </p>
          </li>
          <li>
            <h3 class="font-bold text-carbon">{company.guaranteeYears} years in writing</h3>
            <p class="mt-1 text-sm text-graphite/80">
              A dated document specific to your job, handed over when we finish. If water gets
              back in through our work, we come back and sort it at no cost.
            </p>
          </li>
        </ul>
      </div>
      <div class="lg:sticky lg:top-6">
        <QuoteForm source="Homepage" />
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- Areas -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
    <h2 class="text-2xl sm:text-3xl font-bold text-carbon">Where we work</h2>
    <p class="mt-3 max-w-3xl text-graphite/80">
      Bromley and the towns around it - {areas.slice(1, 8).join(", ")} and out as far as
      {" "}{areas.slice(8).join(", ")}. If you are just outside, ring and ask. We will tell you
      honestly if you would be better off with somebody closer.
    </p>
    <a href="/areas-we-cover" class="mt-5 inline-flex items-center gap-1 font-semibold text-volt-deep hover:underline">
      See the full list<span aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <GbpMap />

  <CallStrip />
</Layout>
