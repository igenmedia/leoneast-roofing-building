---
import Layout from "../layouts/Layout.astro";
import { business, img } from "../data/business";
import { locations } from "../data/locations";
import ContactForm from "../components/ContactForm.astro";
import StatsBar from "../components/StatsBar.astro";
import Reviews from "../components/Reviews.astro";
import Guarantee from "../components/Guarantee.astro";
import NextPage from "../components/NextPage.astro";

const heroImg = img("roof-repair-cost-orpington-hero");

// All figures are our own price bands for this patch, given as ranges because
// access and roof shape move them more than anything else. Nothing here is
// presented as an industry survey or a national average.
const repairPrices = [
  { job: "Single slipped or cracked tile refixed", band: "£180 - £320", note: "From a tower where the pitch and position allow. Scaffolding pushes it higher." },
  { job: "Handful of tiles or slates replaced", band: "£220 - £450", note: "Reclaimed matching stock included. Rare profiles add a few days rather than much money." },
  { job: "Slipped slate refixed with a tingle", band: "£200 - £450", note: "Fine as a repair on a sound roof. Not a fix for general nail fatigue across a slope." },
  { job: "One hip rebedded and repointed", band: "£350 - £650", note: "The most common single repair in the Farnborough and Crofton postcode." },
  { job: "All hips and ridge rebedded, 1930s semi", band: "£900 - £1,600", note: "Four hips plus the ridge run. Priced as one job because the access is shared." },
  { job: "Converted to dry ridge and hip system", band: "£1,300 - £2,400", note: "Mechanically fixed, ventilated, and it ends the mortar cycle for good." },
  { job: "Chimney flashing renewed in lead", band: "£450 - £950", note: "More on taller Victorian houses, where the access is most of the difference." },
  { job: "Chimney repointed above the roof line", band: "£600 - £1,500", note: "Lime mix on older soft brickwork, cement-based on modern brick." },
  { job: "Flaunching renewed, pots rebedded", band: "£350 - £700", note: "Much cheaper again if it is done while the access is already up for something else." },
  { job: "Valley rebuilt", band: "£900 - £2,200", note: "The expensive end of leak work. Boards underneath often need attention too." },
  { job: "Gutters and downpipes cleared", band: "£90 - £180", note: "The best value job on this website, and the one that prevents the priciest ones." },
  { job: "Full roofline - gutters, fascias, soffits", band: "£1,400 - £3,200", note: "Old boards removed rather than capped over, so the rafter ends get seen." },
];

const bigJobs = [
  { job: "Re-roof, three-bed semi, concrete tile", band: "£6,500 - £11,000", note: "Strip, new treated battens, breathable membrane, new tiles, scaffold, skip and disposal." },
  { job: "Re-roof, three-bed semi, clay tile", band: "£7,500 - £14,000", note: "Same specification. Clay materials typically run 30 to 60 per cent above concrete." },
  { job: "Re-roof, larger detached with hips and dormers", band: "£12,000 - £24,000", note: "More cutting, more valleys, more ridge and hip work, longer on site." },
  { job: "Re-slate in reclaimed slate, single slope", band: "£2,500 - £5,500", note: "Sound slates from your own roof re-laid on new battens and fixings." },
  { job: "Re-slate, whole house, natural slate", band: "£14,000 - £28,000", note: "Welsh slate at the top of the range. Access on a tall roof is a serious line item." },
  { job: "Flat roof, EPDM, 15sqm extension", band: "£1,600 - £2,400", note: "Includes tearing off the old covering and taking it away." },
  { job: "Flat roof, GRP fibreglass, 15sqm extension", band: "£1,900 - £2,900", note: "Higher labour content, so complexity moves this figure more than it moves EPDM." },
  { job: "Deck replacement under a flat roof", band: "£25 - £45 per sqm", note: "Only quoted once the old covering is off and we can photograph what is underneath." },
];

const movers = [
  {
    h: "Access, which is usually the biggest surprise",
    p: "Scaffolding on a standard two-storey house is £800 to £1,600 and is charged by the hire period. A chimney access scaffold is less. Some repairs are safe from a tower, which costs a fraction of that, and part of what a survey establishes is which category your job falls into. We put access on its own line so you can see it rather than discover it.",
  },
  {
    h: "The shape of the roof, not just its size",
    p: "A hipped roof costs more than a gabled roof with the same footprint, because every hip means cutting tiles and forming a mortar or dry-fix junction. Valleys, dormers and multiple levels each add the same way. Two houses on the same road with the same floor area can be a thousand pounds apart for this reason alone.",
  },
  {
    h: "What the covering is, and whether it still exists",
    p: "Machine-made clay from the interwar streets is easy to match from salvage. Some 1960s and 70s concrete profiles have been discontinued entirely. Handmade Kentish pegs for the village properties around Chelsfield and Downe are obtainable but cost several times a modern plain tile and take longer to source.",
  },
  {
    h: "What turns up underneath",
    p: "There are really only three surprises on a re-roof: rotten rafter feet or wall plate, a chimney in worse condition than it looked from below, and structural alterations from an old conversion that were never done properly. We flag all three as possibilities on the quote with indicative figures, so if one appears it is a conversation rather than an ambush.",
  },
  {
    h: "Whether it is an emergency",
    p: "Out-of-hours call-outs carry a premium, and we tell you what it is on the phone before setting off rather than adding it afterwards. A temporary make-safe is £180 to £600 depending on access and area, and that comes off the permanent repair if we carry it out.",
  },
  {
    h: "How high up the hill you are",
    p: "Exposed sites need more mechanical fixing than sheltered ones - dry ridge rather than mortar, clips at the verges, properly fastened flat-roof trim. On the high ground at Biggin Hill, Coney Hall and the top of West Wickham that is not an upsell, it is what keeps the roof on. It typically adds a few hundred pounds to a job you are already paying access for.",
  },
];

const faqs = [
  {
    question: "Why do roofers give a range rather than a price?",
    answer:
      "Because until somebody has been on the roof, any single figure is a guess. The two things that move a roofing price most are access and what is found underneath, and neither can be assessed from the pavement. The ranges on this page are honest brackets for this area. What you get after a survey is a single fixed figure, itemised, that does not move.",
  },
  {
    question: "Is it cheaper to repair or to replace?",
    answer:
      "Almost always cheaper to repair, right up until it is not. The turning point is usually the third or fourth call-out in a few years, each in a different place. At that point you are paying for a replacement in instalments and getting no guarantee at the end. The other trigger is the battens: if the timber will not hold a nail, no amount of tile work is a real fix. We will tell you which side of that line you are on and show you the photographs.",
  },
  {
    question: "Will my insurance pay for it?",
    answer:
      "For storm damage, often yes. Most buildings policies cover it, and most define a storm by gust speed - commonly around 55mph, though wordings differ, so read your own. What they generally do not cover is gradual wear and tear, which is why photographing the damage before anybody touches it matters so much. For ordinary age-related repair, insurance is not usually the route. We will tell you honestly which one you are looking at rather than encouraging a claim that will cost you the excess for nothing.",
  },
  {
    question: "Do you ask for money up front?",
    answer:
      "Not for repairs - those are invoiced on completion. On a full re-roof, where several thousand pounds of materials and scaffolding are ordered before we start, a staged arrangement is normal across the trade and we will set the stages out in writing on the quote. Be wary of anyone asking for a large cash deposit before any materials have been ordered.",
  },
  {
    question: "Are these prices including VAT?",
    answer:
      "The figures on this page are indicative bands to help you budget. Your written quote states the VAT position explicitly rather than leaving you to work it out, and the total on it is the total on the invoice. If anything about a quote you have been given elsewhere is unclear on VAT, that is worth resolving before you sign it.",
  },
  {
    question: "Can I get a second opinion from you on someone else's quote?",
    answer:
      "Yes, free, and we are happy to do it. Bring us the quote and we will survey the roof ourselves and tell you what we would do and what we would charge. Sometimes the answer is that the other quote is fair and you should take it. That is a perfectly good outcome and we would rather say it than pretend otherwise.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: "Roof Repair Cost", item: `${business.url}/roof-repair-cost` },
  ],
};
---

<Layout
  title="Roof Repair Cost In Orpington | LeonEast Roofing"
  description="What roof repairs, re-roofing and flat roofing actually cost around Orpington in 2026 - itemised price bands, what moves them, and where the money really goes."
  ogImage={heroImg}
  schema={[faqSchema, breadcrumbSchema]}
>
  <section class="relative bg-ink text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate via-ink to-ink" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16 text-center">
      <nav aria-label="Breadcrumb" class="text-xs text-steel-light/60">
        <a href="/" class="hover:text-brand-light">Home</a>
        <span class="mx-2 text-steel">/</span>
        <span class="text-steel-light">Roof Repair Cost</span>
      </nav>
      <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight leading-tight">
        <a href="/" class="text-white hover:text-brand-light transition-colors">Roof Repair Cost In Orpington</a>
      </h1>
      <h2 class="mt-4 text-xl font-semibold text-brand-light">How much should this actually be costing you?</h2>
      <h3 class="mt-3 text-lg font-semibold text-steel-light">
        Real price bands for repairs, re-roofing and flat roofing on Orpington houses, and an
        honest account of what moves them
      </h3>
      <p class="mt-6 text-lg text-steel-light text-left">
        Roofing prices are hard to research because so few firms publish any. That suits the
        trade and it does not suit you, because it makes comparing two quotes almost
        impossible. So here is what we actually charge around Orpington, in bands, along with
        the reasons a job lands at one end of a band rather than the other. Read it before you
        collect quotes and you will be able to tell a fair price from an optimistic one - which
        is worth more to you than any single number on this page.
      </p>
      <div class="mt-8 text-left">
        <ContactForm page="Cost guide" title="Get a fixed price for your roof" />
      </div>
    </div>
  </section>

  <StatsBar />

  <!-- Repair prices -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">Repairs and maintenance</h2>
    <p class="mt-8 text-center text-slate/70 max-w-3xl mx-auto">
      These are the jobs that make up most of our week. Where a range is wide, it is access
      doing the widening rather than the work itself.
    </p>
    <div class="mt-10 overflow-x-auto">
      <table class="w-full text-left border border-slate/15 rounded-lg overflow-hidden bg-white">
        <thead class="bg-ink text-white">
          <tr>
            <th class="p-4 font-semibold" scope="col">Job</th>
            <th class="p-4 font-semibold whitespace-nowrap" scope="col">Typical range</th>
            <th class="p-4 font-semibold" scope="col">What decides where it lands</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate/10 text-sm">
          {repairPrices.map((r) => (
            <tr>
              <th scope="row" class="p-4 font-semibold text-ink text-left align-top">{r.job}</th>
              <td class="p-4 text-brand-dark font-bold align-top whitespace-nowrap">{r.band}</td>
              <td class="p-4 text-slate/80 align-top">{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Bigger jobs -->
  <section class="bg-white border-y border-slate/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">Re-roofing and flat roofing</h2>
      <p class="mt-8 text-center text-slate/70 max-w-3xl mx-auto">
        The larger jobs, all of them including strip, disposal and access unless the note says
        otherwise. If a quote you have been given is materially below these bands, the thing to
        check is what has been left out of it.
      </p>
      <div class="mt-10 overflow-x-auto">
        <table class="w-full text-left border border-slate/15 rounded-lg overflow-hidden bg-white">
          <thead class="bg-ink text-white">
            <tr>
              <th class="p-4 font-semibold" scope="col">Job</th>
              <th class="p-4 font-semibold whitespace-nowrap" scope="col">Typical range</th>
              <th class="p-4 font-semibold" scope="col">What is in it</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate/10 text-sm">
            {bigJobs.map((r) => (
              <tr>
                <th scope="row" class="p-4 font-semibold text-ink text-left align-top">{r.job}</th>
                <td class="p-4 text-brand-dark font-bold align-top whitespace-nowrap">{r.band}</td>
                <td class="p-4 text-slate/80 align-top">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- What moves the price -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">Six things that move a roofing price</h2>
    <p class="mt-8 text-center text-slate/70 max-w-3xl mx-auto">
      Understanding these is the difference between comparing quotes properly and comparing
      the bottom line on two pieces of paper that describe different jobs.
    </p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {movers.map((m) => (
        <div class="rounded-xl border border-slate/15 bg-white p-6">
          <h3 class="text-lg font-bold text-ink">{m.h}</h3>
          <p class="mt-2 text-sm text-slate/80">{m.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- The cheap quote -->
  <section class="bg-brand/5 border-y border-brand/20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-ink rule">If one quote is much cheaper, find out why</h2>
      <p class="mt-6 text-slate/80">
        A quote several thousand pounds below the others is not usually a bargain, it is a
        different specification. The four places the difference normally hides are: battens
        that are ungraded or untreated, or reused rather than renewed; an overlay instead of a
        strip, which buries every existing problem under a new covering; scaffolding excluded
        and billed later; and a cement fillet instead of a lead flashing at the chimney.
      </p>
      <p class="mt-4 text-slate/80">
        None of those are visible once the job is finished, which is exactly why they are where
        the corner gets cut. Ask each firm to state the batten specification, whether the roof
        is being stripped, whether access is included and for how long, and what the flashing
        material is. Any firm doing the job properly will answer all four in a sentence each.
      </p>
    </div>
  </section>

  <Guarantee />

  <Reviews />

  <!-- FAQ -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">Cost questions, answered straight</h2>
    <div class="mt-10 max-w-3xl mx-auto divide-y divide-slate/15">
      {faqs.map((faq) => (
        <div class="py-6">
          <h3 class="text-lg font-semibold text-ink">{faq.question}</h3>
          <p class="mt-2 text-slate/80">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Areas -->
  <section class="bg-white border-y border-slate/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-ink">These prices apply across our patch</h2>
      <p class="mt-6 text-slate/70 max-w-3xl mx-auto">
        There is no travel surcharge on any of the towns below. Where a local page quotes a
        different band, it is because that town's housing genuinely differs - bigger roofs at
        Chelsfield Park, hung tiling at Petts Wood, simpler gabled estate roofs through the
        Crays.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a href="/" class="rounded-full bg-ink px-4 py-1.5 text-sm font-semibold text-white hover:bg-slate">Orpington</a>
        {locations.map((l) => (
          <a href={`/${l.slug}`} class="rounded-full border border-slate/20 bg-paper px-4 py-1.5 text-sm text-slate/80 hover:border-brand hover:text-brand-dark">{l.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">Swap the range for a fixed figure</h2>
      <p class="mt-6 text-steel-light max-w-2xl mx-auto">
        Bands are useful for budgeting and useless for deciding. A free survey turns one into a
        single itemised number that does not move between the quote and the invoice.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={business.phoneHref} class="inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
          Call {business.phone}
        </a>
        <a href="/contact" class="inline-flex items-center rounded-md border border-steel-light/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10">
          Book A Free Survey
        </a>
      </div>
    </div>
  </section>

  <NextPage current="/roof-repair-cost" />
</Layout>
