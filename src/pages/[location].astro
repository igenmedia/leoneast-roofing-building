---
// Dynamic route for the /{town} location pages. Static pages (services,
// contact, etc.) take priority over this route, so it only catches the
// location slugs returned from getStaticPaths.
import LocationPage from "../layouts/LocationPage.astro";
import { locationPages } from "../data/locationPages";

export function getStaticPaths() {
  return locationPages.map((data) => ({
    params: { location: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
---

<LocationPage data={data} />
